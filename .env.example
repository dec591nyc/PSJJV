# ==============================================================================
# 環境變數範本檔 (.env.example) - 請複製為 .env 並填入相應配置
# ==============================================================================

# 🗄️ 1. 資料庫連線 (預設使用 Turso 雲端 SQLite)
TURSO_DATABASE_URL="libsql://your-db.aws-region.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token"

# 🧠 2. 後端數據服務與 AI 智慧運算 API (Gemini Flash -> 本地 Ollama -> 內建統計引擎)
# 可選模型：gemini-3.6-flash / gemini-2.0-flash / gemini-1.5-flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# 🌐 3. 前端與快取設定
NEXT_PUBLIC_APP_TITLE="台灣地方治安統計與數據完整性分析平台"
CACHE_MAX_AGE="300"
CACHE_STALE_WHILE_REVALIDATE="86400"

# ⚙️ 4. 數據流水線
MOI_DATASET_ID="9603"
